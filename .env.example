# Blank template only. Real values live in Vercel or in your own .env.local, never in git or chat.

# Postgres connection string. The Vercel + Neon integration sets this automatically.
DATABASE_URL=

# Login. A long random value, different for each environment.
BETTER_AUTH_SECRET=
# Optional. The site address; Vercel deployments work it out themselves.
BETTER_AUTH_URL=
# Unlocks /setup to create the first admin. At least 24 characters.
SETUP_TOKEN=
